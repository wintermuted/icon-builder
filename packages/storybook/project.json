{
  "name": "storybook",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/storybook/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["production", "^production", "{workspaceRoot}/preview/styles.css"],
      "outputs": ["{workspaceRoot}/dist/storybook"],
      "options": {
        "command": "npm run build --workspace @wm-asset-workflows/storybook"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project packages/storybook/tsconfig.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "npm run dev --workspace @wm-asset-workflows/storybook"
      }
    }
  },
  "tags": ["scope:ui", "type:application"]
}
