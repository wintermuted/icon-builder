{
  "name": "preview-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/preview-app/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/preview/index.html",
        "{workspaceRoot}/preview/styles.css",
        "{workspaceRoot}/assets/svg/wintermuted-brand/wm-wintermuted-mark.svg"
      ],
      "outputs": ["{workspaceRoot}/dist/preview-app"],
      "options": {
        "command": "npm run build --workspace @wm-asset-workflows/preview-app"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "npm run dev --workspace @wm-asset-workflows/preview-app"
      }
    }
  },
  "tags": ["scope:preview", "type:application"]
}
