{
  "name": "preview-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/preview-server/src",
  "implicitDependencies": ["workflows"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit --project packages/preview-server/tsconfig.json"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "main": "packages/preview-server/src/index.ts",
        "outputPath": "dist/packages/preview-server",
        "tsConfig": "packages/preview-server/tsconfig.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        {
          "projects": ["preview-app"],
          "target": "build"
        },
        {
          "projects": ["workflows"],
          "target": "build-specs"
        }
      ],
      "options": {
        "command": "node dist/packages/preview-server/src/index.js --built",
        "continuous": true
      }
    }
  },
  "tags": ["scope:preview", "type:application"]
}
