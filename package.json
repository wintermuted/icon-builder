{
  "name": "agentic-icon-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.1"
  },
  "volta": {
    "node": "26.13.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "description": "Agentic Icon Builder for SVG-first logo and glyph workflows, previews, and exports.",
  "scripts": {
    "nx": "nx",
    "graph": "nx graph",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:toolchain": "node --test scripts/node/typescript-toolchain.test.mjs",
    "test:file-size": "node --test scripts/node/file-size.test.mjs",
    "test:preview": "node --test --test-concurrency=1 scripts/node/ensure-deps.test.mjs packages/preview-app/test/preview-editor.test.mjs packages/preview-app/test/shared-components.test.mjs packages/preview-app/test/shared-layouts.test.mjs packages/preview-app/test/shared-primitives.test.mjs packages/preview-app/test/editor-presentation.test.mjs packages/preview-app/test/vite-server.test.mjs",
    "test:canvas": "node --test --test-concurrency=1 packages/preview-app/test/canvas-service.test.mjs packages/preview-app/test/canvas-provider.test.mjs packages/preview-app/test/canvas-browser.test.mjs",
    "install:deps": "node scripts/node/install-deps.mjs",
    "preview": "npm run ensure:deps && nx run preview-app:serve",
    "storybook": "nx run storybook:serve",
    "build:storybook": "nx run storybook:build",
    "test:storybook-pages": "node --test packages/storybook/test/pages.test.mjs",
    "ensure:deps": "node scripts/node/ensure-deps.mjs",
    "build:specs": "nx run workflows:build-specs",
    "generate:png": "nx run image-generation:generate-png",
    "capture": "nx run workflows:capture",
    "workflow:logo": "nx run workflows:logo",
    "ui-theme:link-local": "cd ../wintermuted-ui-theme && npm link && cd - && npm link @wintermuted/ui-theme --workspace @wm-asset-workflows/preview-app",
    "ui-theme:unlink-local": "npm unlink --no-save @wintermuted/ui-theme --workspace @wm-asset-workflows/preview-app && npm install"
  },
  "devDependencies": {
    "@nx/js": "24.0.6",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "nx": "24.0.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "playwright": "^1.65.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
